# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

OPENAI_API_KEY=sk-your-api-key-here

# Optional: override the model used for reviews (default: gpt-4o-mini).
# OPENAI_MODEL=gpt-4o-mini

# Optional: GitHub token for the /review-pr endpoint.
# Without it, public PRs still work but GitHub allows only 60 requests/hour.
# IMPORTANT: use a read-only token with the narrowest access you can (a
# fine-grained token limited to public data, or to specific repos). Anyone who
# can call this API can review anything this token can read.
# GITHUB_TOKEN=

# Optional: per-IP rate limits (count/period; ";" separates several limits).
# REVIEW_RATE_LIMIT=10/minute;100/hour
# REVIEW_PR_RATE_LIMIT=5/minute;30/hour
